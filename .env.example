# Copiar pra /srv/apps/kindle-dash/.env no servidor (chmod 600). Nunca commitar o .env.
# Token de longa duração do Home Assistant (usuário → Segurança → Tokens de acesso de longa duração).
# Fica só no servidor: o nginx põe no cabeçalho, o Kindle nunca vê.
KINDLE_HA_TOKEN=
# HA no mesmo servidor (network_mode host)
HA_URL=http://127.0.0.1:8123
